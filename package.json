{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:studio": "node scripts/dev-studio.mjs",
    "start:studio": "STUDIO_PREVIEW=0 node scripts/start-studio.mjs",
    "banking:install": "cd services/banking && uv sync --frozen",
    "banking:test": "cd services/banking && .venv/bin/python -m pytest tests -q",
    "fraud:install": "cd services/fraud && uv sync --frozen",
    "fraud:test": "cd services/fraud && .venv/bin/python -m pytest tests -q",
    "briefing:install": "cd services/briefing && uv sync --frozen",
    "briefing:test": "cd services/briefing && .venv/bin/python -m pytest tests -q",
    "wealth:install": "cd services/wealth && uv sync --frozen",
    "wealth:test": "cd services/wealth && .venv/bin/python -m pytest tests -q",
    "sar:install": "cd services/sar && uv sync --frozen",
    "sar:test": "cd services/sar && .venv/bin/python -m pytest tests -q",
    "platform:test": "services/wealth/.venv/bin/python -m pytest services/llm/tests services/common/tests -q -p no:cacheprovider",
    "interbank:up": "cd services/interbank && uv run --no-project --python 3.12 --with httpx --with pyjwt --with cryptography python labctl.py up",
    "interbank:down": "cd services/interbank && uv run --no-project --python 3.12 --with httpx --with pyjwt --with cryptography python labctl.py down",
    "interbank:status": "cd services/interbank && uv run --no-project --python 3.12 --with httpx --with pyjwt --with cryptography python labctl.py status",
    "interbank:verify": "cd services/interbank && uv run --no-project --python 3.12 --with httpx --with pyjwt --with cryptography python labctl.py verify",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "map:sources": "node --experimental-strip-types scripts/highlight-evidence.ts",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "studio:preview": "STUDIO_PREVIEW=1 STUDIO_START_SERVICES=0 npm run dev -- --port 4200 --strictPort",
    "studio:install": "npm run banking:install && npm run fraud:install && npm run briefing:install && npm run wealth:install && npm run sar:install",
    "studio:doctor": "node scripts/studio-doctor.mjs",
    "start:preview": "STUDIO_PREVIEW=1 node scripts/start-studio.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "drizzle-orm": "0.45.2",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.40.0",
    "motion": "^13.4.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "shiki": "^4.4.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
