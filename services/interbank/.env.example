# labctl does not read this file. It writes .env (LAB_UID/LAB_GID only) and
# .runtime/vendor.env (mode 0600) from the FSI Demo Studio .env, which must define:
#   GALILEO_API_KEY, GALILEO_CONSOLE_URL, AIDEFENSE_API_KEY, AGENT_CONTROL_URL,
#   OPENAI_API_KEY, MODEL_NAME
# and may define GALILEO_API_URL, AIDEFENSE_REGION, AIDEFENSE_TIMEOUT, OPENAI_BASE_URL,
# MODEL_REASONING_EFFORT (default medium).
# OPENAI_API_KEY goes to .runtime/model.env, mounted only by the agents; MODEL_NAME and
# the reasoning effort are not secret and go to .runtime/vendor.env.
# Never place real credentials in this repository.
#
# labctl reads the studio's root .env (../../.env) by default. Point it elsewhere with:
#   FSI_ENV=/path/to/.env python3 labctl.py up
LAB_UID=1000
LAB_GID=1000
