# Optional file-based setup. Studio settings can create and edit root .env.
# Copy to .env only when it does not already exist, then chmod 600 .env.
# Keep secret values in .env. Commit only credential-free examples.

# Model provider. A hosted OpenAI route needs this key; a private endpoint may not.
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
VLLM_API_KEY=
NIM_API_KEY=
NVIDIA_API_KEY=
# Configure other endpoints and model names in Studio settings -> Model backends.
# Optional initial private vLLM route (legacy variable names retained):
# SPARKY_VLLM_BASE_URL=http://127.0.0.1:8003/v1
# SPARKY_VLLM_MODEL=your-served-model-name

# Agent Observability and hosted Agent Control. Use your tenant/project/stream.
# Banking needs registered hosted controls; other demos have their own requirements.
GALILEO_API_KEY=
GALILEO_CONSOLE_URL=https://console.multitenant.galileocloud.io
GALILEO_PROJECT=fsi-demo-studio
GALILEO_LOG_STREAM=engineer-demo
AGENT_CONTROL_URL=https://agent-control.multitenant.galileocloud.io
# GALILEO_API_URL=https://api.multitenant.galileocloud.io

# Cisco AI Defense. Interbank requires a key. Hosted advisory and SAR enforce it.
AIDEFENSE_API_KEY=
AIDEFENSE_REGION=us-west-2
# Leave modes unset to use service defaults. Set enforce to enable inspection.
# AIDEFENSE_MODE=enforce
# BRIEFING_AIDEFENSE_MODE=enforce
# WEALTH_AIDEFENSE_MODE=enforce
# SAR_AIDEFENSE_MODE=enforce
# AIDEFENSE_TIMEOUT=30

# Optional Splunk Observability Cloud export, separate from Agent Observability.
SPLUNK_REALM=
SPLUNK_ACCESS_TOKEN=
# Or use a generic HTTP OTLP collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Host-loopback URLs are translated to host.docker.internal inside use-case containers.
# Optional public corporate CA bundle, read by the operator for image/runtime TLS:
# EXTRA_CA_FILE=/path/to/corporate-ca.pem

# Optional data sources. Use your real SEC contact for EDGAR ticker lookups.
# SEC_USER_AGENT=Your Name you@example.com
PINECONE_API_KEY=
FRED_API_KEY=

# Live GPU fraud scorer. Omit to keep the loopback port 8000 default.
# FRAUD_SCORE_URL=http://127.0.0.1:8000
# Optional local vLLM model download credential (services/llm/serve.sh):
# HF_TOKEN=
